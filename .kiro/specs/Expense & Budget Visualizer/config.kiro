{
  "spec": {
    "name": "Expense & Budget Visualizer",
    "version": "1.0.0",
    "description": "A client-side expense tracker and budget visualizer built with vanilla HTML, CSS, and JavaScript.",
    "entryPoint": "index.html",
    "techStack": {
      "structure": "HTML5",
      "styling": "CSS3",
      "logic": "Vanilla JavaScript (ES6+)",
      "chart": "Chart.js v4 (CDN)",
      "storage": "localStorage"
    },
    "folderRules": {
      "css": "Only 1 file — css/style.css",
      "js": "Only 1 file — js/app.js"
    },
    "features": {
      "mvp": [
        "Input form with validation (Item Name, Amount, Category)",
        "Scrollable transaction list with delete",
        "Total balance auto-update",
        "Pie chart (Chart.js) by category"
      ],
      "optional": [
        "Custom categories — add via inline form next to select",
        "Sort transactions — by date, amount, or category",
        "Dark/light mode toggle — persisted in localStorage"
      ],
      "currency": "Indonesian Rupiah (Rp), manual thousand-separator — no toLocaleString",
      "theme": "light (default) + dark toggle"
    },
    "deployment": {
      "method": "GitHub Pages",
      "branch": "main",
      "root": "/",
      "url": "https://fairusfrans.github.io/CodingCamp-26October26-FairusFransMaulanaPambayunSugiarto/"
    }
  }
}
