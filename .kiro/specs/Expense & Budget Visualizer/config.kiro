{
  "spec": {
    "name": "Expense & Budget Visualizer",
    "version": "1.0.0",
    "description": "A client-side expense tracker and budget visualizer built with vanilla HTML, CSS, and JavaScript.",
    "entryPoint": "index.html",
    "techStack": {
      "structure": "HTML5",
      "styling": "CSS3",
      "logic": "Vanilla JavaScript (ES6+)",
      "chart": "Chart.js v4 (CDN)",
      "storage": "localStorage"
    },
    "folderRules": {
      "css": "Only 1 file — css/style.css",
      "js":  "Only 1 file — js/app.js"
    },
    "features": {
      "mvp": [
        "Input form — Item Name, Amount (Rp), Category (Food/Transport/Fun), inline validation",
        "Scrollable transaction list with delete button per item",
        "Total balance card — auto-updates on add/delete, shows per-category stat pills",
        "Pie chart (Chart.js v4) — spending distribution by category, empty state fallback"
      ],
      "optional": [
        "Custom categories — add via ＋ button next to category select; duplicate check; colour from CUSTOM_PALETTE; persisted in ebv_categories",
        "Sort transactions — Terbaru (newest first) / Jumlah (amount desc) / Kategori (A-Z); persisted in ebv_sort",
        "Dark mode toggle — 🌙/☀️ button in header; sets data-theme on <html>; chart rebuilt on toggle; persisted in ebv_theme"
      ],
      "currency": "Indonesian Rupiah (Rp) — manual thousand-separator regex, range Rp 1 – Rp 5.000.000",
      "theme": "Light mode default + dark mode via [data-theme='dark'] on <html>"
    },
    "localStorage": {
      "ebv_transactions": "Array<{id, name, amount, category}>",
      "ebv_categories":   "Array<{name, icon, color}>",
      "ebv_sort":         "\"date\" | \"amount\" | \"category\"",
      "ebv_theme":        "\"light\" | \"dark\""
    },
    "deployment": {
      "method": "GitHub Pages",
      "branch": "main",
      "root": "/",
      "url": "https://fairusfrans.github.io/CodingCamp-26October26-FairusFransMaulanaPambayunSugiarto/"
    }
  }
}
